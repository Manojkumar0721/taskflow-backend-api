# Database & Application Configuration Template for TaskFlow
# Copy this file to .env or configure these variables in your environment / IDE

# Database Connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=taskflow_db
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Server Port
SERVER_PORT=8080

# JWT Security Configuration
# Provide a 256-bit (32-byte) hex-encoded secret key for signing tokens
JWT_SECRET_KEY=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
# Expiration in milliseconds (86400000 ms = 24 hours)
JWT_EXPIRATION=86400000
